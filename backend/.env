PORT=5000
MONGODB_URI=mongodb://localhost:27017/voter_registration
NODE_ENV=development
CORS_ORIGIN=*
# BACKEND_URL=https://gramsabha.easygov.co.in/be/
BACKEND_URL=http://localhost:5000
JIOMEET_API=https://jiomeetpro.jio.com/api/platform/v1
PRIVATE_KEY_PATH=./keys/RSA-PrivateKey.pem
PUBLIC_KEY_PATH=./keys/RSA-PublicKey.pub
# cron jobs
AGENDA_TRANSLATION_CRON=*/15 * * * *
INITIATE_SUMMARY_CRON=0 * * * *
FETCH_SUMMARY_RESULTS_CRON=0 * * * *
RETRY_FAILED_SUMMARY_CRON=*/15 * * * *
